# Local development only. Never use real patient records in development.
APP_MODE=development
DATABASE_URL=postgresql+psycopg://medicare:local-development-only@127.0.0.1:5432/medicare
REDIS_URL=redis://127.0.0.1:6379/0
LOCAL_DATA_DIR=../../.local
AUTH_PROVIDER=local
STORAGE_PROVIDER=local
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# APP_SECRET and STORAGE_ENCRYPTION_KEY: supply through your secret manager in production.
APP_SECRET=
STORAGE_ENCRYPTION_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=medical-reports
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
CLAMAV_HOST=
CLAMAV_PORT=3310
RETENTION_DAYS=90
API_INTERNAL_URL=http://127.0.0.1:8000
# Comma-separated Supabase user UUIDs provisioned by your operator.
ADMIN_USER_IDS=
# Optional: configured in isolated inference service only, never public ingress.
INFERENCE_URL=
# Separate privileged migration identity; API must use a NOBYPASSRLS role in production.
MIGRATION_DATABASE_URL=
# Isolated research service only (never NEXT_PUBLIC).
INFERENCE_SERVICE_KEY=
ALLOW_RESEARCH_INFERENCE=false
MODEL_ARTIFACT_ROOT=/models
